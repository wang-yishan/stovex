{
	"name": "stovex",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"vercel-build": "(drizzle-kit push --force || echo 'Warning: db:push failed; continuing with build') && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"contrast": "bun scripts/contrast.ts",
		"db:push": "drizzle-kit push --force",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate --force",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@internationalized/date": "^3.12.0",
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "^1.72.0",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.2",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@dnd-kit-svelte/svelte": "^0.2.0",
		"@fontsource-variable/dm-sans": "^5.3.0",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"mode-watcher": "^1.1.0",
		"xlsx": "^0.18.5"
	}
}
