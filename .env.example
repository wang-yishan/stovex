# Environment: DEV = local SQLite, PROD = Turso/remote DB
PROJECT_STATUS=DEV

# Local development (DEV)
# DATABASE_URL=file:local.db

# Production (PROD) - set in Vercel/deploy environment
# PROJECT_STATUS=PROD
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=
# DATABASE_URL= # optional fallback for PROD

ORIGIN="http://localhost:5173"

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
